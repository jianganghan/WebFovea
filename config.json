{
    "api_base": "https://api.anthropic.com/v1",
    "api_model": "claude-opus-4-6",
    "temperature": 0.7,
    "max_tokens": 8192,
    "agent": {
        "max_steps": 80,
        "task_budget_s": 1800,
        "max_reconnect_per_task": 0,
        "default_reference_length": 15,
        "settle_floor_ms": 1000,
        "settle_ceil_ms": 8000,
        "single_tab_reset": true,
        "max_task_attempts": 1,
        "max_worker_respawns": 2,
        "worker_init_retries": 3,
        "max_consecutive_page_failures": 3,
        "run_budget_s": 0,
        "enable_back": true,
        "max_backs_per_task": 15,
        "enable_find_text": true,
        "max_find_text_per_task": 10,
        "find_text_timeout_ms": 3000,
        "enable_read_text": true,
        "max_read_text_per_task": 5,
        "read_text_max_chars": 600,
        "enable_fill": true,
        "fill_timeout_ms": 3000,
        "enable_type_newline_submit": true,
        "enable_iframe_click_fallback": true,
        "enable_provenance_rule": false,
        "enable_click_many": true,
        "model_call_max_attempts": 6,
        "model_call_retry_budget_s": 240
    }
